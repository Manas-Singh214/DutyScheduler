# Copy to .env and replace the placeholder values before running Docker Compose.
APP_SECRET_KEY=replace-with-a-unique-random-secret
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password
PUBLIC_APP_URL=http://localhost:8000
APP_PORT=8000

# Use Resend for HTTPS email delivery (recommended for Render free).
RESEND_API_KEY=
EMAIL_FROM=Exam Duty Allocator <noreply@your-verified-domain.com>

# Or configure SMTP instead of Resend.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RATE_LIMIT_STORAGE_URI=memory://
