# Copy to .env and replace the placeholder values before running Docker Compose.
APP_SECRET_KEY=replace-with-a-unique-random-secret
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password
PUBLIC_APP_URL=http://localhost:8000
APP_PORT=8000

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Exam Duty Allocator <noreply@example.com>
RATE_LIMIT_STORAGE_URI=memory://
